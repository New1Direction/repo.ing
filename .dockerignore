# Default deny: operational artifacts, credentials, Git and private programs never enter the context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!.npmrc
!.railwayignore
!next.config.mjs
!instrumentation.js
!proxy.js
!app/
!app/**
!src/
!src/**
!public/
!public/**
!config/
!config/existing-market-custody.json
!drizzle/
!drizzle/meta/
!drizzle/meta/_journal.json
!vendor/
!vendor/**/
!vendor/**/*.json
!vendor/**/*.mjs
!vendor/**/*.txt
!vendor/**/*.md
!vendor/**/LICENSE
!vendor/**/NOTICE
# Never include private executables or local credentials, even under an allowed directory.
**/.env*
**/*.so
**/*.elf
**/*.pem
**/*.key
**/*keypair*.json
**/*wallet*.json
!vendor/hooklab-event-abi/inclusive-max-wallet-candidate/hook_max_wallet.json
**/*secret*
**/*credentials*
**/node_modules
**/.amp
