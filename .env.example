# APP
APP_ORIGIN=

# DATABASE
DATABASE_URL=

# SOLANA
SOLANA_RPC_URL=
DBC_CONFIG=
# Comma-separated previously approved configs retained when DBC_CONFIG changes.
DBC_LEGACY_CONFIGS=

# GITHUB
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# CREATOR SIGNER
PLATFORM_CREATOR_SECRET_KEY=

# DISCOVERY REWARDS (web only; worker recovers signed intents without this key)
PLATFORM_PARTNER_SECRET_KEY=
DISCOVERY_REWARDS_ENABLED=false
# BUILDER ALLOCATION (web only; launches with an approved config reserve the
# one-time 1% grant; unset keeps the allocation inactive)
BUILDER_ALLOCATION_CONFIGS=

# $REPO BUYBACK EXECUTION GATE (web only; all-or-nothing — unset or incomplete stops execution)
REPO_BUYBACK_EXECUTION_ENABLED=false
REPO_TOKEN_MINT=
REPO_TREASURY_TOKEN_ACCOUNT=
REPO_BUYBACK_VENUE=
REPO_BUYBACK_MAX_SLIPPAGE_BPS=
REPO_BUYBACK_MAX_PRICE_IMPACT_BPS=
REPO_BUYBACK_MIN_SIZE_LAMPORTS=
REPO_BUYBACK_MAX_SIZE_LAMPORTS=

# METADATA
# Served by APP_ORIGIN using the bundled token image.

# PLATFORM OPERATORS (immutable GitHub user IDs, comma-separated; empty denies access)
PLATFORM_OPERATOR_GITHUB_IDS=
# Minimum verified unclaimed builder fees (SOL) before /operations/invites lists a repository
MAINTAINER_INVITE_MIN_SOL=0.5

# PROTOCOL LIQUIDITY (explicit operator-reviewed limits; no default live spending)
# First live run: docs/P3_FIRST_LIVE_RUNBOOK.md and P3_FIRST_LIVE_SETTINGS.json.
# Keep execution false until the manual graduation/revenue/review gates pass.
REPO_LIQUIDITY_EXECUTION_ENABLED=false
REPO_LIQUIDITY_MIN_VOLUME_LAMPORTS=
REPO_LIQUIDITY_TARGET_SOL_LAMPORTS=
REPO_LIQUIDITY_RULES_VERSION=
REPO_LIQUIDITY_MAX_SLIPPAGE_BPS=
REPO_LIQUIDITY_MAX_PRICE_IMPACT_BPS=
REPO_LIQUIDITY_MIN_DEPLOY_LAMPORTS=
REPO_LIQUIDITY_MAX_DEPLOY_LAMPORTS=
# Maximum extra SOL debit for account deposits and network fee, per deployment.
REPO_LIQUIDITY_MAX_NETWORK_COST_LAMPORTS=

# P4 BUILDER REINVEST — preparation only; leave false in production.
BUILDER_REINVEST_ENABLED=false
# Independent read/simulation RPC, needed on web AND worker before activation.
BUILDER_REINVEST_VERIFICATION_RPC_URL=
# Exact settled bounded P3 MAINNET signature; gate re-verifies chain evidence + MATCH.
BUILDER_REINVEST_P3_SIGNATURE=
# Local validator rehearsal only; rejected for mainnet or NODE_ENV=production.
BUILDER_REINVEST_LOCAL_REHEARSAL=false

# Read-only P5 graduation verification. Use a separate provider; no spending authority.
GRADUATION_VERIFICATION_RPC_URL=

# P6 read-only public trend intake (worker). Does not approve or launch markets.
TREND_INTAKE_ENABLED=false

# Optional web-only natural-language repository search. No wallet/trading authority.
# The key stays on the server; keyword search and filters work without it.
REPO_SMART_SEARCH_ENABLED=false
TYPESAFE_API_KEY=

# Worker-only reserve movement alerts. Read-only; no transaction authority.
# Net change >= 0.05 SOL, at most once per five minutes per market.
RESERVE_ALERTS_ENABLED=false
# Private HTTPS receiver. JSON: event, id, text, market (reserve evidence).
# Keep in Railway worker secrets; never expose webhook credentials to the browser.
RESERVE_ALERT_WEBHOOK_URL=

# Reviewed DBC partner-fee collection, after reserving unpaid discovery rewards.
# Destination is a public SOL wallet. This does not enable unattended sweeps.
PLATFORM_FEE_TREASURY_WALLET=
PLATFORM_DBC_COLLECTION_ENABLED=false

# Optional double-opt-in builder earnings email digests. Web AND worker.
# Configure a verified sender and a random shared secret before enabling.
BUILDER_REMINDERS_ENABLED=false
RESEND_API_KEY=
BUILDER_REMINDER_FROM=
BUILDER_REMINDER_SECRET=

# Optional public agent review tools. Web only; migration 0022 required.
# Random secret of at least 32 bytes. Signs one-hour review links, never transactions.
AGENT_LAUNCH_ENABLED=false
AGENT_LAUNCH_SECRET=
