# APP
APP_ORIGIN=

# DATABASE
DATABASE_URL=

# SOLANA
SOLANA_RPC_URL=
DBC_CONFIG=
# Comma-separated previously approved configs retained when DBC_CONFIG changes.
DBC_LEGACY_CONFIGS=

# GITHUB
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# CONNECT X (web only; optional — unset either value to hide the feature). X OAuth 2.0 confidential web app, read-only
# (users.read tweet.read). Callback: https://repo.ing/api/x/callback; X_CALLBACK_URL overrides it for local development.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# CREATOR SIGNER
PLATFORM_CREATOR_SECRET_KEY=

# DISCOVERY REWARDS (web only; worker recovers signed intents without this key)
PLATFORM_PARTNER_SECRET_KEY=
DISCOVERY_REWARDS_ENABLED=false
# VERIFICATION BONUS (web only; docs/VERIFICATION_BONUS.md). New launches are stamped with this many lamports
# (0.001–1 SOL, expected 250000000); unset enrolls nothing. Payouts come from PLATFORM_PARTNER_SECRET_KEY, stay off
# until enabled, never exceed the rolling 30-day cap (default 5 SOL), and always leave the payer its in-flight payouts,
# its unallocated and undeployed-liquidity revenue, plus this reserve (default 0.05 SOL). The worker accrues bonuses
# and settles signed payouts with no key.
VERIFICATION_BONUS_LAMPORTS=
VERIFICATION_BONUS_PAYOUTS_ENABLED=false
VERIFICATION_BONUS_MAX_PER_30D_LAMPORTS=
VERIFICATION_BONUS_PAYER_RESERVE_LAMPORTS=
# REPO TIPS (web only; unset disables tips entirely). Base58 or JSON byte array of a DEDICATED tip wallet — never
# reuse a payout, partner or custody key. TIP_WALLET_ADDRESS is optional on web (must match the key if set) and is the
# only tip setting the worker needs (settlement/recovery of already-signed transfers and the balance-vs-liability alert).
# PARTS FUNDS use the same tip wallet (enabled with tips). Deciding lists at their deadline needs no key, but the
# all-or-nothing payouts/refunds are signed by the worker only if it ALSO has TIP_WALLET_SECRET_KEY; otherwise a
# maintainer's "Send now" sends them from web and /operations/health flags closed lists left waiting.
TIP_WALLET_SECRET_KEY=
TIP_WALLET_ADDRESS=
# BUILDER ALLOCATION (web only; launches with an approved config reserve the
# one-time 1% grant; unset keeps the allocation inactive)
BUILDER_ALLOCATION_CONFIGS=

# HUGGING FACE MODEL MARKETS (web; docs/HUGGING_FACE_API_NOTES.md)
# "true" turns on every model route, page section and launch; anything else keeps them dormant. On the worker, "true"
# also adds model markets to launch and milestone alert posts (docs/ALERTS_SETUP.md); keep it the same as on web.
HF_MARKETS_ENABLED=false
# Stock-paired markets (docs/STOCK_QUOTES.md): "true" offers a mapped company's tokenized stock (METAx, MSFTx, NVDAx) as a
# launch pair beside SOL; anything else offers SOL only. Keep it off until quote-aware creation, indexing and fees ship.
STOCK_QUOTES_ENABLED=false
# The Hugging Face OAuth app (scopes: openid profile read-memberships); sign-in refuses cleanly while any is unset.
HF_OAUTH_CLIENT_ID=
# Its client secret; also derives the Hugging Face cookie keys, so rotating it ends every Hugging Face session.
HF_OAUTH_CLIENT_SECRET=
# Exactly https://<APP_ORIGIN host>/api/hf/callback, registered on the OAuth app.
HF_OAUTH_REDIRECT_URI=

# $REPO BUYBACK EXECUTION GATE (web only; all-or-nothing — unset or incomplete stops execution)
REPO_BUYBACK_EXECUTION_ENABLED=false
REPO_TOKEN_MINT=
REPO_TREASURY_TOKEN_ACCOUNT=
REPO_BUYBACK_VENUE=
REPO_BUYBACK_MAX_SLIPPAGE_BPS=
REPO_BUYBACK_MAX_PRICE_IMPACT_BPS=
REPO_BUYBACK_MIN_SIZE_LAMPORTS=
REPO_BUYBACK_MAX_SIZE_LAMPORTS=

# METADATA
# Served by APP_ORIGIN using the bundled token image.

# PLATFORM OPERATORS (immutable GitHub user IDs, comma-separated; empty denies access)
PLATFORM_OPERATOR_GITHUB_IDS=
# Minimum verified unclaimed builder fees (SOL) before /operations/invites lists a repository
MAINTAINER_INVITE_MIN_SOL=0.5

# PROTOCOL LIQUIDITY (explicit operator-reviewed limits; no default live spending)
# First live run: docs/P3_FIRST_LIVE_RUNBOOK.md and P3_FIRST_LIVE_SETTINGS.json.
# Keep execution false until the manual graduation/revenue/review gates pass.
REPO_LIQUIDITY_EXECUTION_ENABLED=false
REPO_LIQUIDITY_MIN_VOLUME_LAMPORTS=
REPO_LIQUIDITY_TARGET_SOL_LAMPORTS=
REPO_LIQUIDITY_RULES_VERSION=
REPO_LIQUIDITY_MAX_SLIPPAGE_BPS=
REPO_LIQUIDITY_MAX_PRICE_IMPACT_BPS=
REPO_LIQUIDITY_MIN_DEPLOY_LAMPORTS=
REPO_LIQUIDITY_MAX_DEPLOY_LAMPORTS=
# Maximum extra SOL debit for account deposits and network fee, per deployment.
REPO_LIQUIDITY_MAX_NETWORK_COST_LAMPORTS=

# P4 BUILDER REINVEST — preparation only; leave false in production.
BUILDER_REINVEST_ENABLED=false
# Independent read/simulation RPC, needed on web AND worker before activation.
BUILDER_REINVEST_VERIFICATION_RPC_URL=
# Exact settled bounded P3 MAINNET signature; gate re-verifies chain evidence + MATCH.
BUILDER_REINVEST_P3_SIGNATURE=
# Local validator rehearsal only; rejected for mainnet or NODE_ENV=production.
BUILDER_REINVEST_LOCAL_REHEARSAL=false

# Read-only P5 graduation verification. Use a separate provider; no spending authority.
GRADUATION_VERIFICATION_RPC_URL=
# Optional, worker: more independent providers asked in order, per request, when the one above refuses it (rate limit,
# blocked call, outage). Comma-separated; a URL on the SOLANA_RPC_URL provider's host is ignored.
GRADUATION_VERIFICATION_FALLBACK_RPC_URLS=

# P6 read-only public trend intake (worker). Does not approve or launch markets.
TREND_INTAKE_ENABLED=false

# Optional web-only natural-language repository search. No wallet/trading authority.
# The key stays on the server; keyword search and filters work without it.
REPO_SMART_SEARCH_ENABLED=false
TYPESAFE_API_KEY=

# Worker-only reserve movement alerts. Read-only; no transaction authority.
# Net change >= 0.05 SOL, at most once per five minutes per market.
RESERVE_ALERTS_ENABLED=false
# Private HTTPS receiver. JSON: event, id, text, market (reserve evidence).
# Keep in Railway worker secrets; never expose webhook credentials to the browser.
RESERVE_ALERT_WEBHOOK_URL=

# Worker-only public "new market launched" posts (docs/PRODUCTION.md#launch-alerts). Migration 0034 required.
# Off unless enabled AND the cutoff AND at least one channel's credentials are set. Only markets indexed at/after
# LAUNCH_ALERTS_SINCE (ISO timestamp) and within the last 24 hours are ever posted. Default cap 15 posts/day/channel.
LAUNCH_ALERTS_ENABLED=false
LAUNCH_ALERTS_SINCE=
LAUNCH_ALERTS_MAX_PER_DAY=
# Telegram bot (admin of the channel/group) and target chat: @public_channel or numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# X developer app with Read and Write permission; OAuth 1.0a keys plus the posting account's access token/secret.
# Not the X_CLIENT_ID/X_CLIENT_SECRET used for "Connect X".
X_BOT_API_KEY=
X_BOT_API_SECRET=
X_BOT_ACCESS_TOKEN=
X_BOT_ACCESS_SECRET=
# Worker-only graduation milestone posts (25/50/75/90% and graduation) to the same channels
# (docs/PRODUCTION.md#graduation-milestone-alerts). Migration 0037 required. Off unless enabled AND the cutoff is set;
# markets are first only marked at their current milestone, so nothing reached before is ever posted. Default 10/day/channel.
GRADUATION_ALERTS_ENABLED=false
GRADUATION_ALERTS_SINCE=
GRADUATION_ALERTS_MAX_PER_DAY=
# Web and worker: do-not-promote list (docs/PRODUCTION.md#do-not-promote-list), comma-separated GitHub repository IDs.
# Left out of /waiting, the graduation race, "Repo markets to watch" and milestone alerts; markets and fees unaffected.
PROMOTION_EXCLUDED_REPO_IDS=
# Web: optional threshold (ms) for the {"slowLoader":…} log of server data loaders (default 150).
SERVER_TIMING_SLOW_MS=

# Reviewed DBC partner-fee collection, after reserving unpaid discovery rewards.
# Destination is a public SOL wallet. This does not enable unattended sweeps.
PLATFORM_FEE_TREASURY_WALLET=
PLATFORM_DBC_COLLECTION_ENABLED=false

# Optional double-opt-in builder earnings email digests. Web AND worker.
# Configure a verified sender and a random shared secret before enabling.
BUILDER_REMINDERS_ENABLED=false
RESEND_API_KEY=
BUILDER_REMINDER_FROM=
BUILDER_REMINDER_SECRET=

# Optional public agent review tools. Web only; migration 0022 required.
# Random secret of at least 32 bytes. Signs one-hour review links, never transactions.
AGENT_LAUNCH_ENABLED=false
AGENT_LAUNCH_SECRET=
